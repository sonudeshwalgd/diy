{
  "expo": {
    "name": "diy",
    "slug": "diy",
    "version": "1.13.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "diy",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sonudeshwal.diy"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sonudeshwal.diy"
    },
    "web": {
      "favicon": "./assets/favicon2.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      "expo-font",
      "expo-splash-screen",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "08a3eaca-8afc-4b34-93a4-0812e7acc5e9"
      }
    },
    "owner": "sonudeshwal"
  }
}
